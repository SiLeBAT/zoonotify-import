{
  "name": "zoonotify-import",
  "version": "1.0.0",
  "private": true,
  "description": "Zoonotify Import CLI — bulk-loads the source workbook into the Zoonotify CMS via the Import admin API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zoonotify-import": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:integration": "node test/integration/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "p-limit": "^6.2.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "esbuild": "^0.28.0",
    "eslint": "^9.10.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
